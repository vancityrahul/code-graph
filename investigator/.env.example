# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock model — cross-region inference profile ARN
# Example: us.anthropic.claude-sonnet-4-5-20250514-v2:0
# Verify the exact ARN for claude-sonnet-4-6 in your region at:
# https://docs.aws.amazon.com/bedrock/latest/userguide/inference-profiles-support.html
BEDROCK_MODEL_ID=

# Bedrock Agent Core Memory resource ID
BEDROCK_MEMORY_ID=

# Path to the mcp-server-code-graph directory
MCP_SERVER_PATH=../mcp-server-code-graph

# Langfuse (optional — tracing is no-op if absent)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Agent budgets
MAX_USD_PER_QUERY=0.50
MAX_TURNS=25
