# AWS credentials for Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Bedrock cross-region inference profile ID — must include regional prefix (us. / eu. / global.)
# Example: us.anthropic.claude-haiku-4-5-20251001-v1:0
# Base IDs like anthropic.claude-haiku-4-5-20251001-v1:0 (no prefix) will 400 — on-demand throughput not supported
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Bedrock Agent Core Memory resource ID
BEDROCK_MEMORY_ID=

# Path to the mcp-server-code-graph directory
MCP_SERVER_PATH=../mcp-server-code-graph

# Optional S3 bucket to cache cloned repos (GitHub URLs are cloned then uploaded here)
S3_REPO_BUCKET=

# Langfuse (optional — tracing is no-op if absent)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Agent budgets
MAX_USD_PER_QUERY=0.50
MAX_TURNS=25
